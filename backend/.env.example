# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit real secrets.

# Random long string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=00dd3530b334580bd68154eb7309227908a5649e36002d8e426617d95b50886c

# development | production
NODE_ENV=development

# Port the server listens on
PORT=3000

# Optional: the email address below is automatically promoted to the
# "admin" role the moment it registers. Leave blank to disable this and
# use `node scripts/make-admin.js <email>` instead.
ADMIN_EMAIL=
