# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit real secrets.

# Random long string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=0d3f2f220e54ab47640fe13a47b4ae0c663c070524366d074d35d5f5a51e8699

# development | production
NODE_ENV=development

# Port the server listens on
PORT=3000

# Optional: the email address below is automatically promoted to the
# "admin" role the moment it registers. Leave blank to disable this and
# use `node scripts/make-admin.js <email>` instead.
ADMIN_EMAIL=
