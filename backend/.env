# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit real secrets.

# Random long string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=adc0717f1be03e01c3f5b9e29c22c801da4868329fcdecea0f47dd6cfb95e5c3

# development | production
NODE_ENV=development

# Port the server listens on
PORT=3000

# Optional: the email address below is automatically promoted to the
# "admin" role the moment it registers. Leave blank to disable this and
# use `node scripts/make-admin.js <email>` instead.
ADMIN_EMAIL=
